# Leave DATABASE_URL empty to run on a local SQLite file (zero setup, good for a first run).
# For Supabase: Project settings -> Database -> Connection string -> URI (use the pooler on port 6543).
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# Optional. Without a key the platform still runs end to end on the built-in extraction
# and assistant engines; with a key those two steps get an LLM pass on top.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Comma separated. Add your Codespaces forwarded frontend URL here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
